generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Configurações globais do usuário (linha única, id fixo = 1)
model UserSettings {
  id                Int      @id @default(1)
  defaultCaption    String   @default("🚀 Transforme sua presença digital. Confira o link da bio!")
  useDefaultCaption Boolean  @default(true)
  postsPerDay       Int      @default(5)
  automationEnabled Boolean  @default(false)
  // ACTIVE | PAUSED | INTERVENTION_REQUIRED
  automationStatus  String   @default("PAUSED")
  keepBrowserOpen   Boolean  @default(false)
  // Capa padrão aplicada a novos vídeos da fila (sistema de capa personalizada)
  defaultCoverPath  String?
  useDefaultCover   Boolean  @default(false)
  // Limpeza automática de cache (arquivos temporários do app — ver server/services/cacheManager.js)
  cacheAutoCleanEnabled       Boolean   @default(false)
  cacheAutoCleanIntervalHours Int       @default(24)
  lastCacheCleanAt            DateTime?
  // Modo de agendamento: TIMES (horários específicos) | INTERVAL (a cada X minutos)
  scheduleMode        String   @default("TIMES")
  intervalMinutes     Int      @default(5)
  // Início do modo intervalo: NOW (a partir de agora) | AT (horário específico em intervalStartAt, "HH:mm")
  intervalStartMode   String   @default("NOW")
  intervalStartAt     String?
  updatedAt         DateTime @updatedAt
}

// Um vídeo na fila (pendente, agendado, publicando, publicado ou com falha)
model Video {
  id           String        @id @default(uuid())
  filename     String
  filepath     String
  thumbnail    String?
  duration     Float?
  size         Int?
  caption      String?
  // Capa personalizada deste vídeo (sistema de capa — ver server/services/coverManager.js)
  coverPath    String?
  coverEnabled Boolean       @default(true)
  // PENDING | SCHEDULED | PUBLISHING | PUBLISHED | FAILED
  status       String        @default("PENDING")
  position     Int           @default(0)
  createdAt    DateTime      @default(now())
  publishedAt  DateTime?
  failedAt     DateTime?
  publications Publication[]
  // Conta dona deste video. Null = conta padrao (dados anteriores ao
  // multi-conta continuam validos e sao tratados como da conta padrao).
  accountId    String?
  account      Account?      @relation(fields: [accountId], references: [id])
  // REEL | STORY — define por qual fluxo do publicador o video sai.
  mediaType    String        @default("REEL")

  @@index([accountId])
}

// Um agendamento concreto: vídeo X vinculado a um horário Y
model Publication {
  id           String    @id @default(uuid())
  videoId      String
  video        Video     @relation(fields: [videoId], references: [id])
  scheduledAt  DateTime
  publishedAt  DateTime?
  // SCHEDULED | PUBLISHING | PUBLISHED | FAILED
  status       String    @default("SCHEDULED")
  attempts     Int       @default(0)
  errorMessage String?
  createdAt    DateTime  @default(now())
  accountId    String?
  account      Account?  @relation(fields: [accountId], references: [id])

  @@index([accountId])
}

// Horário recorrente de publicação diária (ex: 12:00, 14:00...)
model Schedule {
  id      Int     @id @default(autoincrement())
  time    String
  enabled Boolean @default(true)
  // Horarios sao por conta. Null = conta padrao.
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])
  // REEL | STORY — permite grades de horario distintas para reels e stories,
  // como na referencia, que trata "Reels em Massa" e "Stories em Massa" separado.
  mediaType String  @default("REEL")
  // Variacao aleatoria em minutos aplicada ao redor de `time` (0 = desligado,
  // comportamento identico ao original). Ex: 14:00 com jitter 10 => publica
  // em algum instante entre 13:50 e 14:10. Ver schedulerService.applyJitter.
  jitterMinutes Int @default(0)
}

// Log de eventos do sistema (auditoria e depuração)
model Log {
  id         Int      @id @default(autoincrement())
  timestamp  DateTime @default(now())
  video      String?
  action     String
  // INFO | SUCCESS | ERROR | WARNING
  status     String   @default("INFO")
  message    String?
  attempt    Int?
  durationMs Int?
}

// ============================================================
// EDITOR DE REELS EM MASSA
// ============================================================

// Um template visual reutilizável (header, título, container de vídeo,
// background, marca d'água, bordas, áudio, exportação). O campo `config`
// guarda um JSON com toda a estrutura — ver server/services/reelTemplate.js
// para o schema completo em runtime.
model VideoTemplate {
  id              String           @id @default(uuid())
  name            String
  config          String // JSON serializado
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  processingJobs  ProcessingJob[]
  processedVideos ProcessedVideo[]
}

// Um lote de processamento em massa: N vídeos + 1 template.
model ProcessingJob {
  id             String           @id @default(uuid())
  templateId     String
  template       VideoTemplate    @relation(fields: [templateId], references: [id])
  // PENDING | PROCESSING | COMPLETED | CANCELLED | FAILED
  status         String           @default("PENDING")
  totalVideos    Int              @default(0)
  completedCount Int              @default(0)
  failedCount    Int              @default(0)
  cancelledCount Int              @default(0)
  concurrency    Int              @default(2)
  autoQueue      Boolean          @default(false)
  autoSchedule   Boolean          @default(false)
  // Conta de destino do lote. Sem isso os videos processados nasciam com
  // accountId null e o agendador — que filtra por conta — nunca os via.
  accountId      String?
  account        Account?         @relation(fields: [accountId], references: [id])
  mediaType      String           @default("REEL")
  createdAt      DateTime         @default(now())
  finishedAt     DateTime?
  items          ProcessedVideo[]
}

// Um vídeo individual dentro de um ProcessingJob (origem -> resultado).
model ProcessedVideo {
  id             String        @id @default(uuid())
  jobId          String
  job            ProcessingJob @relation(fields: [jobId], references: [id])
  templateId     String
  template       VideoTemplate @relation(fields: [templateId], references: [id])
  sourceFilename String
  sourcePath     String
  outputFilename String?
  outputPath     String?
  // PENDING | PROCESSING | COMPLETED | FAILED | CANCELLED
  status         String        @default("PENDING")
  progress       Int           @default(0)
  errorMessage   String?
  addedToQueue   Boolean       @default(false)
  queuedVideoId  String?
  createdAt      DateTime      @default(now())
  finishedAt     DateTime?
}

// Vídeo de origem enviado para o Editor em Massa (antes de ser processado).
// Independente da fila de publicação (`Video`) — só entra lá depois de
// processado, se o usuário mandar para a fila.
model EditorSourceVideo {
  id         String   @id @default(uuid())
  filename   String
  filepath   String
  thumbnail  String?
  duration   Float?
  size       Int?
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())
}

// ============================================================
// BIBLIOTECA DE CONTEUDO (legendas e hashtags)
// ============================================================
// Modelos aditivos: nada aqui altera o fluxo de publicacao existente.
// Sao usados sob demanda pela pagina "Legendas & Hashtags", que aplica
// os textos em lote aos videos PENDING da fila (gravando em Video.caption).

// Uma legenda reutilizavel. `weight` permite que legendas melhores
// aparecam mais vezes no sorteio; `usedCount` registra quantas vezes ja
// foi aplicada, para o rodizio distribuir de forma equilibrada.
model CaptionTemplate {
  id        String   @id @default(uuid())
  text      String
  label     String?
  enabled   Boolean  @default(true)
  weight    Int      @default(1)
  usedCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Um grupo de hashtags (ex: "futebol", "promo"). `hashtags` guarda o
// texto cru como o usuario digitou — a normalizacao (# e deduplicacao)
// acontece em server/services/contentLibrary.js.
model HashtagGroup {
  id        String   @id @default(uuid())
  name      String
  hashtags  String
  enabled   Boolean  @default(true)
  usedCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// PASTAS MONITORADAS (importacao automatica)
// ============================================================
// Equivalente local a "sincronizacao de pasta do Drive": aponta-se uma
// pasta qualquer do disco — inclusive a do Google Drive / OneDrive /
// Dropbox ja sincronizada pelo app de desktop — e todo video novo que
// aparece nela entra na fila sozinho. Nao exige OAuth nem credenciais.

model WatchFolder {
  id          String   @id @default(uuid())
  path        String   @unique
  label       String?
  enabled     Boolean  @default(true)
  // COPY = mantem o arquivo original na pasta de origem (padrao, mais seguro)
  // MOVE = remove da origem depois de importar, evitando reprocessar
  importMode  String   @default("COPY")
  // Aplica uma legenda da biblioteca no momento da importacao
  autoCaption Boolean  @default(false)

  lastScanAt    DateTime?
  lastError     String?
  importedCount Int      @default(0)

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  imports   ImportedFile[]
}

// Registro do que ja foi importado, para o mesmo arquivo nao entrar duas
// vezes na fila. A identidade e (pasta + caminho + tamanho + mtime): se o
// usuario editar o video e salvar por cima, o mtime muda e ele e tratado
// como um arquivo novo — que e o comportamento esperado.
model ImportedFile {
  id            String      @id @default(uuid())
  watchFolderId String
  watchFolder   WatchFolder @relation(fields: [watchFolderId], references: [id], onDelete: Cascade)
  sourcePath    String
  size          Int
  mtimeMs       Float
  videoId       String?
  importedAt    DateTime    @default(now())

  @@unique([watchFolderId, sourcePath, size, mtimeMs])
  @@index([watchFolderId])
}

// ============================================================
// CONTAS DO INSTAGRAM (multi-conta)
// ============================================================
// Cada conta tem sessao Playwright propria em playwright/session/<id>/ e
// sua propria grade de horarios, fila e estado de automacao.
//
// NAO ha mascaramento de fingerprint nem navegador anti-deteccao: o isolamento
// aqui e apenas de sessao (cookies/storageState separados), para o app nao
// misturar contas. Rodar muitas contas continua sendo risco de bloqueio pelo
// Instagram — ver os avisos do README.

model Account {
  id       String  @id @default(uuid())
  username String  @unique
  label    String?

  connected       Boolean   @default(false)
  lastConnectedAt DateTime?

  // ATIVA quando active = true e automationStatus = ACTIVE
  active           Boolean @default(true)
  automationStatus String  @default("PAUSED") // ACTIVE | PAUSED | INTERVENTION_REQUIRED

  // Conta usada por telas que ainda nao selecionam conta explicitamente, e
  // dona dos registros com accountId null (dados anteriores ao multi-conta).
  isDefault Boolean @default(false)

  // Configuracao por conta — espelha o que era global em UserSettings
  defaultCaption    String?
  useDefaultCaption Boolean @default(true)
  scheduleMode      String  @default("TIMES") // TIMES | INTERVAL
  intervalMinutes   Int     @default(5)

  // "Ordem aleatoria" da referencia: em vez de seguir a posicao da fila,
  // sorteia qual video pendente vai para cada slot.
  randomOrder Boolean @default(false)

  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  videos         Video[]
  schedules      Schedule[]
  publications   Publication[]
  processingJobs ProcessingJob[]
}
