# Porta do backend (API)
PORT=3001

# String de conexao do banco SQLite (usada pelo Prisma)
DATABASE_URL="file:./data/app.db"

# Pasta raiz onde os videos sao armazenados (pending/published/failed)
VIDEOS_DIR=./videos

# Pasta onde a sessao autenticada do navegador (storageState) e salva
SESSION_DIR=./playwright/session

# false = abre o navegador visivel (necessario para login manual e para
# perceber pedidos de intervencao, como CAPTCHA/2FA). Recomendado manter false.
HEADLESS=false

# Intervalo (ms) em que o agendador verifica se ha publicacoes pendentes
SCHEDULER_INTERVAL_MS=15000

# Numero maximo de tentativas de publicacao por video antes de mover para /failed
MAX_ATTEMPTS=3

# Mantem a janela do navegador aberta entre publicacoes (true/false)
KEEP_BROWSER_OPEN=false
